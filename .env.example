# ---------- Gmail (Google Cloud > APIs & Services) ----------
# 1. Enable the Gmail API.  2. OAuth consent screen (add the support mailbox as a test user).
# 3. Credentials > Create OAuth client ID > "Desktop app".  4. Run `email-router auth` once.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=        # optional: instead of data/gmail-token.json (servers / Docker)
# GMAIL_AUTH_PORT=53682
GMAIL_QUERY=in:inbox is:unread newer_than:7d -category:promotions -category:social
GMAIL_MAX_PER_RUN=25
# REPLY_FROM_NAME=Northwind Outfitters Support
# LABEL_PREFIX=AI             # labels: AI/Refund, AI/Order Tracking, AI/Account, AI/Needs Human ...
# MARK_READ=false             # also mark drafted emails as read

# Real-time push (optional; otherwise use `watch` or POLL_INTERVAL_SEC)
# GMAIL_PUBSUB_TOPIC=projects/<project>/topics/gmail-support
# GMAIL_PUSH_TOKEN=<long random string>   # Pub/Sub push URL: https://<host>/webhooks/gmail?token=<this>

# ---------- Replies ----------
REPLY_MODE=draft              # draft = agent reviews every reply (recommended) | send = auto-send when safe
AUTO_SEND_INTENTS=order_tracking
AUTO_SEND_MIN_CONFIDENCE=0.85
DRAFT_ON_ESCALATION=true      # false = escalated emails get labels only, no draft
BUSINESS_FILE=examples/business.json   # company profile, tone, signature, links, refund policy

# ---------- Orders (pick one; default is the sample JSON file) ----------
# ORDERS_SOURCE=json|http|shopify|none
ORDERS_FILE=examples/orders.json
# ORDERS_API_URL=https://your-backend/orders?number={order}&email={email}
# ORDERS_API_TOKEN=
# SHOPIFY_SHOP=your-store                 # your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...          # custom app with read_orders
# SHOPIFY_API_VERSION=2025-10
REQUIRE_EMAIL_MATCH=true      # only share order details with the email that placed the order

# ---------- Escalation ----------
ESCALATE_ANGER=75
# VIP_DOMAINS=bigclient.com
# VIP_EMAILS=ceo@bigclient.com
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=            # any JSON webhook: n8n, Make, Zapier, Teams workflow

# ---------- Server ----------
PORT=3000
API_KEY=                      # required header x-api-key for /api/*
POLL_INTERVAL_SEC=0           # >0: `serve` also polls the inbox every N seconds
# DATA_DIR=./data

# ---------- AI (multi-model fallback: models without a key are skipped) ----------
GEMINI_API_KEY=               # https://aistudio.google.com/apikey
GROQ_API_KEY=                 # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=               # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=           # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,groq:llama-3.3-70b-versatile
AI_TIMEOUT_MS=10000           # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000      # whole answer
AI_HEDGE_MS=6000              # start the next model in parallel if the current one is silent this long (0 = off)
# AI_DISABLED=false           # true = keyword rules + templates only
