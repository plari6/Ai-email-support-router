{
  "name": "ai-email-support-router",
  "version": "1.0.0",
  "description": "Reads a Gmail support inbox, sorts refunds, order tracking and account issues with AI, and drafts grounded replies with order data and refund policy checks.",
  "type": "module",
  "bin": {
    "email-router": "bin/email-router.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node bin/email-router.js serve",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "demo": "node bin/email-router.js demo",
    "doctor": "node bin/email-router.js doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["gmail-api", "customer-support", "email-automation", "gemini", "express", "refunds", "order-tracking", "ai"],
  "author": "plari6",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  }
}
